---
import { t } from '../i18n/translations';

const lang = Astro.url.searchParams.get('lang') || 'es';
---

<a class="skip-link" href="#content" data-i18n="skip-link">{t(lang, 'skip-link')}</a>

<header class="topnav">
  <div class="container topnav-inner">
    <span class="logo">CodingSpace</span>
    <nav>
      <a href="#about" data-i18n="nav-about">{t(lang, 'nav-about')}</a>
      <a href="#projects" data-i18n="nav-projects">{t(lang, 'nav-projects')}</a>
      <a href="#experience" data-i18n="nav-experience">{t(lang, 'nav-experience')}</a>
      <a href="#contact" data-i18n="nav-contact">{t(lang, 'nav-contact')}</a>
      <div class="lang-toggle">
        <button class={lang === 'es' ? 'active' : ''} data-lang="es">ES</button>
        <button class={lang === 'en' ? 'active' : ''} data-lang="en">EN</button>
      </div>
      <a href="https://github.com/juan1417" class="btn btn-secondary" target="_blank" rel="noopener">GitHub</a>
    </nav>
  </div>
</header>

<script>
  import { i18n } from '../i18n/translations';

  function setLang(lang: string) {
    document.documentElement.lang = lang;
    localStorage.setItem('lang', lang);

    document.querySelectorAll('.lang-toggle button').forEach(btn => {
      btn.classList.toggle('active', (btn as HTMLButtonElement).dataset.lang === lang);
    });

    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = (el as HTMLElement).dataset.i18n;
      if (key && i18n[lang]?.[key] !== undefined) {
        el.innerHTML = i18n[lang][key];
      }
    });

    document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
      const key = (el as HTMLElement).dataset.i18nPlaceholder;
      if (key && i18n[lang]?.[key] !== undefined) {
        (el as HTMLInputElement).placeholder = i18n[lang][key];
      }
    });
  }

  document.querySelectorAll('.lang-toggle button').forEach(btn => {
    btn.addEventListener('click', () => setLang((btn as HTMLButtonElement).dataset.lang || 'es'));
  });

  const savedLang = localStorage.getItem('lang') || 'es';
  setLang(savedLang);
</script>
