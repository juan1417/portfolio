---
import { t } from '../i18n/translations';
import { MinimalPillButton } from 'astro-component-kit/buttons';
import SectionHeading from './SectionHeading.astro';

const lang = Astro.url.searchParams.get('lang') || 'es';
// Placeholder: replace with the real WhatsApp number before deploying.
const whatsappNumber = '57TU_NUMERO';
const whatsappMessage = encodeURIComponent('Hola Juan, vi tu portafolio y me gustaría contactarte.');
---

<section class="section" id="contact">
  <div class="container">
    <SectionHeading index="04" titleKey="contact-title" introKey="contact-intro" headingId="contact-title" />

    <div class="contact-layout">
      <div class="contact-intro">
        <p class="lead" data-i18n="contact-lead">{t(lang, 'contact-lead')}</p>
        <div class="social-links">
          <MinimalPillButton href="https://github.com/juan1417" variant="ghost" size="sm">GitHub</MinimalPillButton>
          <MinimalPillButton href="https://www.linkedin.com/in/juanmachado1234" variant="ghost" size="sm">LinkedIn</MinimalPillButton>
        </div>
      </div>

      <div class="contact-form" data-whatsapp-number={whatsappNumber}>
        <div class="contact-card">
          <div class="field">
            <label for="name" data-i18n="contact-name">{t(lang, 'contact-name')}</label>
            <input type="text" id="name" class="input" autocomplete="name" data-i18n-placeholder="contact-name-ph" placeholder={t(lang, 'contact-name-ph')} />
          </div>
          <div class="field">
            <label for="message" data-i18n="contact-msg">{t(lang, 'contact-msg')}</label>
            <textarea id="message" class="textarea" data-i18n-placeholder="contact-msg-ph" placeholder={t(lang, 'contact-msg-ph')}></textarea>
          </div>
          <a
            href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
            target="_blank"
            rel="noopener"
            class="btn btn-primary"
            data-i18n="contact-send"
          >
            {t(lang, 'contact-send')}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLElement>('.contact-form');
  const whatsappNumber = form?.dataset.whatsappNumber;

  document.querySelector('.contact-form .btn-primary')?.addEventListener('click', event => {
    const name = (document.getElementById('name') as HTMLInputElement)?.value || '';
    const message = (document.getElementById('message') as HTMLTextAreaElement)?.value || '';

    const text = encodeURIComponent(`Hola Juan, soy ${name}. ${message}`);
    (event.currentTarget as HTMLAnchorElement).href = `https://wa.me/${whatsappNumber}?text=${text}`;
  });
</script>
