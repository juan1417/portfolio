---
import { t } from '../i18n/translations';
import { Badge } from 'astro-component-kit/feedback';

const lang = Astro.url.searchParams.get('lang') || 'es';

const devProjects = [
  {
    pill: 'Full-Stack',
    meta: 'Dart · Django · Flutter',
    title: 'ProFinancas',
    descKey: 'proj-1-desc',
    tags: ['Django', 'Flutter', 'JWT', 'SQLite'],
    url: 'https://github.com/juan1417/ProFinancas'
  },
  {
    pill: 'Desktop',
    meta: 'Python · PostgreSQL · PyQt',
    title: 'Gestor de Inventario',
    descKey: 'proj-2-desc',
    tags: ['Python', 'PostgreSQL', 'PyQt', 'SQLAlchemy'],
    url: 'https://github.com/juan1417/gestor-de-inventario'
  },
  {
    pill: 'Lenguaje',
    meta: 'C++',
    title: 'Zeta',
    descKey: 'proj-3-desc',
    tags: ['C++', 'Compiler', 'DSL'],
    url: 'https://github.com/juan1417/zeta'
  },
  {
    pill: 'TUI',
    meta: 'Python',
    title: 'CalendarPy',
    descKey: 'proj-4-desc',
    tags: ['Python', 'Textual', 'TUI'],
    url: 'https://github.com/juan1417/CalendarPy'
  },
  {
    pill: 'Mobile',
    meta: 'Dart · Flutter',
    title: 'Storage-Manager',
    descKey: 'proj-5-desc',
    tags: ['Dart', 'Flutter', 'Mobile'],
    url: 'https://github.com/juan1417/Storage-Manager'
  },
  {
    pill: 'Web',
    meta: 'JavaScript',
    titleKey: 'proj-6-title',
    descKey: 'proj-6-desc',
    tags: ['JavaScript', 'k6', 'Testing'],
    url: 'https://github.com/juan1417/Pruebas-de-Carga-y-Estr-s-con-k6'
  }
];

const mlProjects = [
  {
    pill: 'ML',
    meta: 'Python · scikit-learn',
    titleKey: 'ml-1-title',
    descKey: 'ml-1-desc',
    tags: ['Python', 'scikit-learn', 'Pandas', 'Regresión'],
    url: ''
  },
  {
    pill: 'IA / LLM',
    meta: 'Python',
    titleKey: 'ml-2-title',
    descKey: 'ml-2-desc',
    tags: ['Python', 'LLM', 'Agents', 'NLP'],
    url: 'https://github.com/juan1417/LLMtools'
  },
  {
    pill: 'Herramienta',
    meta: 'Python',
    titleKey: 'ml-3-title',
    descKey: 'ml-3-desc',
    tags: ['Python', 'API', 'Automation'],
    url: 'https://github.com/juan1417/Creator_cv'
  }
];
---

<section class="section" id="projects">
  <div class="container stack" style="gap: 40px;">
    <div style="max-width: 36ch;">
      <p class="eyebrow fade-up" data-i18n="projects-eyebrow">{t(lang, 'projects-eyebrow')}</p>
      <h2 id="projects-title" class="fade-up fade-up-delay-1" data-i18n="projects-title">{t(lang, 'projects-title')}</h2>
    </div>
    <div class="tabs fade-up fade-up-delay-2" role="tablist" aria-labelledby="projects-title">
      <button
        class="tab-btn"
        id="tab-btn-desarrollo"
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls="tab-desarrollo"
        tabindex="0"
        data-tab="desarrollo"
        data-i18n="tab-dev"
      >{t(lang, 'tab-dev')}</button>
      <button
        class="tab-btn"
        id="tab-btn-ml"
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="tab-ml"
        tabindex="-1"
        data-tab="ml"
        data-i18n="tab-ml"
      >{t(lang, 'tab-ml')}</button>
    </div>

    <div class="tab-panel" id="tab-desarrollo" role="tabpanel" aria-labelledby="tab-btn-desarrollo" tabindex="0">
      <div class="grid-2">
        {devProjects.map((proj, i) => (
          <div class={`project-card fade-up fade-up-delay-${i % 4}`}>
            <div class="row-between" style="margin-bottom: 12px;">
              <span class="pill">{proj.pill}</span>
              <span class="meta">{proj.meta}</span>
            </div>
            <h3>{proj.titleKey ? t(lang, proj.titleKey) : proj.title}</h3>
            <p data-i18n={proj.descKey}>{t(lang, proj.descKey)}</p>
            <div class="project-tags">
              {proj.tags.map(tag => (
                <Badge>{tag}</Badge>
              ))}
            </div>
            {proj.url && (
              <a href={proj.url} class="btn btn-ghost btn-arrow" style="margin-top: 16px; padding-left: 0;" target="_blank" rel="noopener" data-i18n="view-repo">{t(lang, 'view-repo')}</a>
            )}
          </div>
        ))}
      </div>
    </div>

    <div class="tab-panel" id="tab-ml" role="tabpanel" aria-labelledby="tab-btn-ml" tabindex="0" hidden>
      <div class="grid-2">
        {mlProjects.map((proj, i) => (
          <div class={`project-card fade-up fade-up-delay-${i % 4}`}>
            <div class="row-between" style="margin-bottom: 12px;">
              <span class="pill">{proj.pill}</span>
              <span class="meta">{proj.meta}</span>
            </div>
            <h3>{proj.titleKey ? t(lang, proj.titleKey) : proj.title}</h3>
            <p data-i18n={proj.descKey}>{t(lang, proj.descKey)}</p>
            <div class="project-tags">
              {proj.tags.map(tag => (
                <Badge>{tag}</Badge>
              ))}
            </div>
            {proj.url && (
              <a href={proj.url} class="btn btn-ghost btn-arrow" style="margin-top: 16px; padding-left: 0;" target="_blank" rel="noopener" data-i18n="view-repo">{t(lang, 'view-repo')}</a>
            )}
          </div>
        ))}
      </div>
      <div class="card fade-up fade-up-delay-3" style="text-align: center; padding: 40px; margin-top: var(--gap-lg);">
        <p style="color: var(--muted); margin: 0;" data-i18n="ml-learning" set:html={t(lang, 'ml-learning')}></p>
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('#projects [role="tab"]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('#projects [role="tabpanel"]'));

  function activateTab(tab: HTMLButtonElement, moveFocus = false) {
    const tabName = tab.dataset.tab;

    tabs.forEach(candidate => {
      const selected = candidate === tab;
      candidate.setAttribute('aria-selected', String(selected));
      candidate.tabIndex = selected ? 0 : -1;
    });

    panels.forEach(panel => {
      panel.hidden = panel.id !== `tab-${tabName}`;
    });

    if (moveFocus) tab.focus();

    document.getElementById(`tab-${tabName}`)?.querySelectorAll<HTMLElement>('.fade-up').forEach(el => {
      el.classList.remove('visible');
      void el.offsetWidth;
      el.classList.add('visible');
    });
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activateTab(tab));

    tab.addEventListener('keydown', event => {
      if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;

      event.preventDefault();
      let nextIndex = index;
      if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
      if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
      if (event.key === 'Home') nextIndex = 0;
      if (event.key === 'End') nextIndex = tabs.length - 1;
      activateTab(tabs[nextIndex], true);
    });
  });
</script>
