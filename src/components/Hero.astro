---
import { t } from '../i18n/translations';
import { MinimalPillButton } from 'astro-component-kit/buttons';

const lang = Astro.url.searchParams.get('lang') || 'es';

const facts = [
  { labelKey: 'fact-focus-label', valueKey: 'fact-focus-value' },
  { labelKey: 'fact-study-label', valueKey: 'fact-study-value' },
  { labelKey: 'fact-availability-label', valueKey: 'fact-availability-value' }
];
---

<section class="section hero">
  <div class="container hero-layout">
    <div>
      <p class="eyebrow" data-i18n="hero-eyebrow">{t(lang, 'hero-eyebrow')}</p>
      <h1 data-i18n="hero-title">{t(lang, 'hero-title')}</h1>
      <p class="lead" data-i18n="hero-lead">{t(lang, 'hero-lead')}</p>
      <div class="hero-cta">
        <MinimalPillButton href="#projects" variant="secondary" size="lg">
          <span data-i18n="hero-cta-1">{t(lang, 'hero-cta-1')}</span>
        </MinimalPillButton>
        <MinimalPillButton href="#contact" variant="primary" size="lg">
          <span data-i18n="hero-cta-2">{t(lang, 'hero-cta-2')}</span>
        </MinimalPillButton>
      </div>
    </div>

    <aside class="hero-panel" aria-labelledby="hero-panel-title">
      <h2 id="hero-panel-title" data-i18n="hero-panel-title">{t(lang, 'hero-panel-title')}</h2>
      <ul class="fact-list">
        {facts.map(fact => (
          <li class="fact-row">
            <span class="fact-label" data-i18n={fact.labelKey}>{t(lang, fact.labelKey)}</span>
            <span class="fact-value" data-i18n={fact.valueKey}>{t(lang, fact.valueKey)}</span>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</section>
