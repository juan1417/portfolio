---
import { t } from '../i18n/translations';
import SectionHeading from './SectionHeading.astro';

const lang = Astro.url.searchParams.get('lang') || 'es';

const experiences = [
  {
    titleKey: 'exp-1-title',
    period: '2023 — Presente',
    org: 'Universidad Pascual Bravo',
    descKey: 'exp-1-desc'
  },
  {
    titleKey: 'exp-2-title',
    period: '2022 — Presente',
    orgKey: 'exp-2-org',
    descKey: 'exp-2-desc'
  },
  {
    titleKey: 'exp-3-title',
    period: '2022 — Presente',
    orgKey: 'exp-3-org',
    descKey: 'exp-3-desc'
  }
];

const certs = [
  { title: 'GitHub Pro', descKey: 'cert-1-desc' },
  { title: 'Pair Extraordinaire', descKey: 'cert-2-desc' },
  { title: 'Pull Shark', descKey: 'cert-3-desc' },
  { title: 'YOLO', descKey: 'cert-4-desc' }
];
---

<section class="section" id="experience">
  <div class="container">
    <SectionHeading index="03" titleKey="exp-title" introKey="exp-intro" headingId="experience-title" />

    <div class="grid-2-1">
      <ol class="timeline">
        {experiences.map(exp => (
          <li class="timeline-item">
            <div class="row-between">
              <h3 data-i18n={exp.titleKey}>{t(lang, exp.titleKey)}</h3>
              <span class="meta">{exp.period}</span>
            </div>
            <p class="org">{exp.orgKey ? t(lang, exp.orgKey) : exp.org}</p>
            <p data-i18n={exp.descKey}>{t(lang, exp.descKey)}</p>
          </li>
        ))}
      </ol>

      <div>
        <h3 class="certs-title" data-i18n="certs-eyebrow">{t(lang, 'certs-eyebrow')}</h3>
        <ul class="cert-list">
          {certs.map(cert => (
            <li class="cert-item">
              <h4>{cert.title}</h4>
              <p data-i18n={cert.descKey}>{t(lang, cert.descKey)}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
